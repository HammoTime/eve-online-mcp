{
  "name": "eve-online-mcp",
  "version": "0.6.0",
  "description": "Read-only MCP access to the complete EVE Online ESI OpenAPI surface",
  "keywords": [
    "eve-online",
    "esi",
    "mcp",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HammoTime/eve-online-mcp.git"
  },
  "homepage": "https://github.com/HammoTime/eve-online-mcp#readme",
  "bugs": {
    "url": "https://github.com/HammoTime/eve-online-mcp/issues"
  },
  "type": "module",
  "bin": {
    "eve-online-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && tsx scripts/build-assets.ts",
    "clean": "node --eval \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "dev": "tsx src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "schema:check": "tsx scripts/check-openapi-update.ts",
    "schema:update": "tsx scripts/update-openapi.ts",
    "skills:verify-data": "tsx scripts/verify-skill-data.ts",
    "start": "node dist/index.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:lib && npm test && npm run build && npm run smoke:telemetry",
    "smoke:telemetry": "tsx scripts/smoke-telemetry.ts",
    "typecheck:lib": "tsc -p lib/tsconfig.runtime.json --noEmit",
    "diagnostics:export": "tsx lib/adapters/diagnostics-cli.ts export",
    "diagnostics:replay": "tsx lib/adapters/diagnostics-cli.ts replay"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/otlp-transformer": "^0.219.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "jose": "^6.2.12",
    "open": "^11.0.2",
    "yauzl": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.1",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
